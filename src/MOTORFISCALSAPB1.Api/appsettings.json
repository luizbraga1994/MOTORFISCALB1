{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/api-.log", "rollingInterval": "Day" } }
    ]
  },
  "AllowedHosts": "*",

  "HanaDbConnection": {
    "Server": "hana-host:30015",
    "Port": "30015",
    "Database": "SBO_COMP",
    "UserID": "SYSTEM",
    "Password": "__OVERRIDE_IN_appsettings.Production.json__",
    "MaxPoolSize": 100,
    "MinPoolSize": 10,
    "ConnectionTimeout": 60,
    "CommandTimeout": 300
  },

  "SapServiceLayer": {
    "BaseUrl": "https://sap-host:50000",
    "CompanyDB": "SBO_COMP",
    "UserName": "manager",
    "Password": "__OVERRIDE_IN_appsettings.Production.json__",
    "Language": 29,
    "IgnoreSslErrors": true,
    "TimeoutSeconds": 180,
    "MaxRetryAttempts": 3,
    "SessionTimeoutMinutes": 25
  },

  "Structure": {
    "ManifestPath": "manifests/structure.json"
  }
}
