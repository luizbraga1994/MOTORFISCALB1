<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Addon LightWeight SAP B1 — .NET 10 multi-bitness (x86 + x64).

      - TargetFramework: net10.0-windows (requerido por WinForms / COM).
      - Platforms: x86;x64 — gera dois binarios, um por bitness, para
        casar com o bitness do SAP B1 Client instalado (o registro COM
        do SAPbouiCOM/SAPbobsCOM e bitness-specifico).
      - RuntimeIdentifiers: usado pelo publish self-contained.
      - O entrypoint (este .exe) e invocado pelo AddOn Launcher do SAP B1
        em processo separado, passando a connection string em args[0].
      - Empacotamento via ZIP (sem MSI). Scripts em build/ geram
        MOTORFISCALSAPB1.Addon-<versao>-x86.zip e ...-x64.zip.
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x86;x64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <!-- NAO fixar PlatformTarget aqui: a plataforma vem por
         /p:Platform=x86 ou /p:Platform=x64 nos scripts de build. -->
    <RootNamespace>MOTORFISCALSAPB1.Addon</RootNamespace>
    <AssemblyName>MOTORFISCALSAPB1.Addon</AssemblyName>
    <!-- Copia toda DLL de PackageReference para o output (requerido para
         deployment LightWeight: o ZIP precisa ser auto-contido). -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>pdbonly</DebugType>
    <!-- NOTE: Adicione as referencias a SAPbouiCOM.dll e SAPbobsCOM.dll
         manualmente apos clonar o repositorio. Elas vem da instalacao do
         SAP Business One Client e nao podem ser redistribuidas via NuGet.
         Marque Copy Local = False (o client do SAP ja possui as DLLs).
         Os Interop assemblies sao AnyCPU — o mesmo arquivo serve x86
         e x64; o binding pro COM acontece em runtime. -->
  </PropertyGroup>
  <ItemGroup>
    <COMReference Include="SAPbobsCOM">
      <WrapperTool>tlbimp</WrapperTool>
      <VersionMinor>0</VersionMinor>
      <VersionMajor>10</VersionMajor>
      <Guid>fc8030be-f5d2-4b8e-8f92-44228fe30100</Guid>
      <Lcid>0</Lcid>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>False</Private>
    </COMReference>
    <COMReference Include="SAPbouiCOM">
      <WrapperTool>tlbimp</WrapperTool>
      <VersionMinor>0</VersionMinor>
      <VersionMajor>10</VersionMajor>
      <Guid>6048236a-956d-498d-a6f1-9c81c13ab6e8</Guid>
      <Lcid>0</Lcid>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>False</Private>
    </COMReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Sem Newtonsoft.Json: Addon usa System.Text.Json (built-in no .NET 10),
         consistente com a serializacao padrao da Api em ASP.NET Core. -->
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- ConfigurationManager / App.config no .NET 10 precisa do pacote
         (no .NET Framework vinha built-in). -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MOTORFISCALSAPB1.Shared\MOTORFISCALSAPB1.Shared.csproj" />
  </ItemGroup>
</Project>
